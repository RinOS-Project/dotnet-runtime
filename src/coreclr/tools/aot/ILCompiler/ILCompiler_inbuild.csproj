<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="Publish;PublishItemsOutputGroup">
  <PropertyGroup>
    <CrossHostArch Condition="'$(_BuildAnyCrossArch)' == 'true'">$(BuildArchitecture)</CrossHostArch>
    <_IsPublishing>true</_IsPublishing>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <PublishDir>$(RuntimeBinDir)$(BuildArchitecture)/ilc/</PublishDir>
    <!-- RinOS cross-builds disable apphost generation for the target graph.
         This project is a host-side build tool, so publish it framework
         dependent and non-single-file in that graph instead of triggering
         NETSDK1067/NETSDK1098. -->
    <SelfContained>true</SelfContained>
    <SelfContained Condition="'$(TargetOS)' == 'rinos' or '$(UseAppHost)' == 'false'">false</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishSingleFile Condition="'$(TargetOS)' == 'rinos' or '$(UseAppHost)' == 'false'">false</PublishSingleFile>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CrossBuild)' != 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
  </PropertyGroup>
  <Import Project="ILCompiler.props" />
</Project>
