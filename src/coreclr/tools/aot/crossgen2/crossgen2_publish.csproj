<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="Publish;PublishItemsOutputGroup">
  <!-- This project is publishes a self-contained copy of crossgen2. -->
  <PropertyGroup>
    <!-- crossgen2 is executed on the build host while cross-building RinOS.
         Use the host JIT artifacts from the architecture-specific directory. -->
    <CrossHostArch Condition="'$(CrossBuild)' == 'true' or '$(TargetArchitecture)' != '$(BuildArchitecture)' or '$(HostOS)' != '$(TargetOS)' or '$(TargetsLinuxBionic)' == 'true' or '$(EnableNativeSanitizers)' != ''">$(BuildArchitecture)</CrossHostArch>
    <_IsPublishing>true</_IsPublishing>
    <!-- Use portable/base RIDs to ensure restore works for AOT tools, avoiding opaque distro-specific TargetRid in source-build scenarios -->
    <RuntimeIdentifier>$(PortableOS)-$(TargetArchitecture)</RuntimeIdentifier>
    <PublishDir>$(RuntimeBinDir)crossgen2-published/</PublishDir>
    <!-- RinOS cross-builds run this host-side tool on the build machine.
         Keep the publish graph framework dependent and disable AOT/single-file
         output when the target graph has no compatible apphost. -->
    <SelfContained>true</SelfContained>
    <SelfContained Condition="'$(TargetOS)' == 'rinos' or '$(UseAppHost)' == 'false'">false</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishTrimmed Condition="'$(TargetOS)' == 'rinos' or '$(UseAppHost)' == 'false'">false</PublishTrimmed>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <AotOrSingleFile>true</AotOrSingleFile>
    <AotOrSingleFile Condition="'$(TargetOS)' == 'rinos' or '$(UseAppHost)' == 'false'">false</AotOrSingleFile>
    <UseBootstrapLayout Condition="'$(UseBootstrap)' == 'true'">true</UseBootstrapLayout>
  </PropertyGroup>

  <Import Project="crossgen2.props" />
</Project>
